scan(H, h -> (L := h#1; f := product(L, l -> l#0*x + l#1*y + l#2*z);
   J := ideal(diff(x, f), diff(y, f), diff(z, f)); C := res J;
   print("R " | toString(h#0) | " " | toString(length C) | " " | toString(sort apply(flatten degrees C_2, d -> d - 16)))));
print "DONE";