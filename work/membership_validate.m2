R = ZZ/3[x_1..x_4]; QC = product {1*x_2+1*x_3+2*x_4,1*x_2+2*x_3+1*x_4,1*x_2+2*x_3+2*x_4,1*x_1+1*x_3+2*x_4,1*x_1+2*x_3+1*x_4,1*x_1+2*x_3+2*x_4,1*x_1+1*x_2+2*x_4,1*x_1+1*x_2+2*x_3,1*x_1+1*x_2+2*x_3+2*x_4,1*x_1+2*x_2,1*x_1+2*x_2+1*x_4,1*x_1+2*x_2+2*x_4,1*x_1+2*x_2+1*x_3,1*x_1+2*x_2+1*x_3+1*x_4,1*x_1+2*x_2+1*x_3+2*x_4,1*x_1+2*x_2+2*x_3,1*x_1+2*x_2+2*x_3+1*x_4,1*x_1+2*x_2+2*x_3+2*x_4}; Rb = R/ideal(QC);
v = j -> matrix apply(4, i -> {(sub(R_i, Rb))^(3^j)});
M = v(0) | v(1) | v(2);
print("free 22-plane example (expect true): " | toString((v(3) % M) == 0));
R = ZZ/3[x_1..x_4]; QC = product {1*x_2+2*x_3+1*x_4,1*x_2+2*x_3+2*x_4,1*x_1+2*x_4,1*x_1+1*x_3+1*x_4,1*x_1+1*x_3+2*x_4,1*x_1+2*x_3,1*x_1+2*x_3+1*x_4,1*x_1+2*x_3+2*x_4,1*x_1+1*x_2,1*x_1+1*x_2+1*x_4,1*x_1+1*x_2+2*x_4,1*x_1+1*x_2+1*x_3+1*x_4,1*x_1+1*x_2+1*x_3+2*x_4,1*x_1+1*x_2+2*x_3,1*x_1+1*x_2+2*x_3+2*x_4,1*x_1+2*x_2,1*x_1+2*x_2+1*x_4,1*x_1+2*x_2+2*x_4,1*x_1+2*x_2+1*x_3,1*x_1+2*x_2+1*x_3+1*x_4,1*x_1+2*x_2+1*x_3+2*x_4,1*x_1+2*x_2+2*x_3,1*x_1+2*x_2+2*x_3+1*x_4,1*x_1+2*x_2+2*x_3+2*x_4}; Rb = R/ideal(QC);
v = j -> matrix apply(4, i -> {(sub(R_i, Rb))^(3^j)});
M = v(0) | v(1) | v(2);
print("non-free control with 16 planes (expect false): " | toString((v(3) % M) == 0));
